# --- CNIC OCR microservice — BACKEND ONLY. Never ship these to the app. ---

# Your Supabase project URL (same project the mobile app + admin use).
SUPABASE_URL=https://nhbapalvgwyjyywynkyz.supabase.co

# Service role key — Supabase dashboard -> Project Settings -> API -> service_role.
# Grants full DB + Storage access. Keep it secret; only this service holds it.
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket the mobile app uploads CNIC images to. Leave as-is.
CNIC_BUCKET=cnic-documents

# PaddleOCR language pack. CNIC numbers are Latin digits -> "en".
OCR_LANG=en

# Reject downloads larger than this many MB.
MAX_IMAGE_MB=10

# Max OCR wall-time (seconds) before the request returns ocr_failed.
OCR_TIMEOUT_SECONDS=25

# Optional browser CORS allow-list (comma separated). The React Native app
# does NOT need this. Leave empty unless a web client calls the service.
ALLOWED_ORIGINS=
